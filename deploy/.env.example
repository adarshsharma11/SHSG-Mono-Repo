# Copy to /opt/shsg/.env.production on EC2. Never commit the populated file.
AWS_REGION=ap-southeast-2
# Replace ACCOUNT_ID with your AWS account ID. Create these three ECR repositories.
IMAGE_REGISTRY=ACCOUNT_ID.dkr.ecr.ap-southeast-2.amazonaws.com
IMAGE_TAG=REPLACE_WITH_SUCCESSFUL_COMMIT_SHA
POSTGRES_DB=shsg
POSTGRES_USER=shsg
# Generate each secret independently: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SHSG_AUTH_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
SHSG_APP_URL=http://15.134.206.246:9002
SHSG_CORS_ORIGINS=http://15.134.206.246:9001,http://15.134.206.246:9002
WEBSITE_PORT=9001
APP_PORT=9002
