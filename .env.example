# Optional overrides for docker compose. Defaults work without copying this file.
# Local development only; use separate credentials and deployment configuration elsewhere.
POSTGRES_DB=shsg
POSTGRES_USER=shsg
POSTGRES_PASSWORD=shsg_local_password
POSTGRES_PORT=5432
API_PORT=8000
SHSG_ENABLE_DEV_DIAGNOSTICS=false
SHSG_CORS_ORIGINS=http://localhost:9001,http://localhost:9002
