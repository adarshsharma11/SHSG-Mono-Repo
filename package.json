{
  "name": "shsg",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:website": "pnpm --filter @shsg/website dev",
    "dev:app": "pnpm --filter @shsg/app dev",
    "dev:api": "pnpm --filter @shsg/api dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  }
}
